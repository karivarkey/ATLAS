# --- Atlas server configuration (no secrets in the repo) ---
# Get a key at https://opencode.ai/auth, then export it before starting.
# PowerShell:  $env:OPENCODE_ZEN_API_KEY="..."
# Bash:        export OPENCODE_ZEN_API_KEY="..."

OPENCODE_ZEN_API_KEY=
OPENCODE_GO_BASE=https://opencode.ai/inference/go/v1
OLLAMA_BASE=http://localhost:11434

ATLAS_DATA_DIR=./data
ATLAS_WORKSPACES_DIR=./workspaces
ATLAS_DB_PATH=
ATLAS_DEFAULT_MODEL=opencode-go/glm-5.3-flash
ATLAS_CATALOG_TTL=3600
ATLAS_MAX_CONCURRENT=4
ATLAS_MAX_STEPS=60
ATLAS_EXEC_TIMEOUT=1800
ATLAS_SHELL_TIMEOUT=120
# 1 = auto-approve file/shell tools inside the workspace; destructive commands always ask.
ATLAS_AUTO_APPROVE=1
ATLAS_SERVER_PASSWORD=
ATLAS_CORS_ORIGINS=http://localhost:5173
